{
  "name": "dwguard-dsh-hmos",
  "version": "0.9.5",
  "description": "DwGuard-Dsh-Hmos — DSH 侧的鸿蒙双 Agent 编排与外部审计插件：任务包、对抗预审、派发、四维验收、返工与知识沉淀，外加设计参考库/范式包推荐、审计门禁、包级反馈与推荐基准。",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "bin": {
    "dwguard-hmos": "bin/dwguard.mjs"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "bin/",
    "skills/",
    "knowledge/",
    "scripts/",
    "preset/",
    "docs/",
    "benchmarks/",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "harmonyos",
    "arkts",
    "deveco",
    "dual-agent",
    "audit",
    "design-rag",
    "design-system",
    "recommendation",
    "ui-design"
  ],
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.1-rc.0 <0.3.0",
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "preflight": "node scripts/preflight.mjs",
    "pretest": "npm run build && node scripts/preflight.mjs",
    "test": "node --test tests/*.test.mjs",
    "verify:publish": "node scripts/verify-publish.mjs",
    "soak": "node scripts/soak.mjs",
    "soak:100": "node scripts/soak.mjs --rounds 100",
    "doctor": "node bin/dwguard.mjs doctor",
    "review": "node bin/dwguard.mjs review",
    "bridge": "node bin/dwguard.mjs bridge",
    "bench": "node bin/dwguard.mjs bench",
    "design:guide": "node scripts/fetch-design-guide.mjs",
    "design:foundations": "node scripts/render-design-foundations.mjs",
    "design:check": "node --test tests/design-knowledge.test.mjs",
    "design:search": "node scripts/search-design-guide.mjs",
    "prepublishOnly": "npm run typecheck && npm run build && npm test && node scripts/verify-publish.mjs",
    "release": "node scripts/release.mjs",
    "release:dry": "node scripts/release.mjs --bump=patch --dry-run"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5 || ~4.1.0",
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.5",
    "@deepseek-ai/schemastery": "~3.18.5 || ~3.19.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@deepseek-ai/schemastery": "3.19.0",
    "@types/node": "^22.0.0",
    "semver": "^7.7.3",
    "typescript": "5.6.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dogwind221/dwguard-dsh-hmos.git"
  },
  "homepage": "https://github.com/Dogwind221/dwguard-dsh-hmos",
  "bugs": {
    "url": "https://github.com/Dogwind221/dwguard-dsh-hmos/issues"
  }
}
