{
  "schemaVersion": 1,
  "sops": [
    {
      "id": "SOP-01",
      "title": "环境就绪",
      "phase": "env",
      "purpose": "在写代码前确认 DevEco/SDK/设备/签名可用，避免把环境问题误判为代码问题。",
      "inputs": ["工程路径", "目标 SDK", "设备池", "签名材料"],
      "steps": ["检查 devecocli/npm/hvigor 版本", "列出设备并确认在线", "验证签名配置可读", "跑一次空构建或版本命令"],
      "gate": ["版本命令退出码 0", "目标设备在线", "签名材料不缺失"],
      "evidence": ["deveco env 结果", "device list", "构建日志"],
      "rules": ["ENG-04", "ENG-05"]
    },
    {
      "id": "SOP-02",
      "title": "需求澄清",
      "phase": "intake",
      "purpose": "把模糊需求变成可证伪的任务包，写清目标/范围/非目标/验收。",
      "inputs": ["用户原话", "目标用户", "平台与设备", "品牌约束"],
      "steps": ["复述用户目标与边界", "确认功能/审美/性能/无障碍四维", "列出非目标", "标注仍不确定的问题"],
      "gate": ["每条判据可证伪", "至少一条 must", "非目标写清"],
      "evidence": ["tasks/spec.md"],
      "rules": ["ENG-01"]
    },
    {
      "id": "SOP-03",
      "title": "架构设计",
      "phase": "architecture",
      "purpose": "在实现前确定页面结构、状态流、数据源、平台适配与回退路径。",
      "inputs": ["任务包", "现有工程结构", "设计参考", "约束"],
      "steps": ["画页面/导航/状态流", "列出共享状态与副作用", "标出折叠屏/深色/大字体断点", "确定失败与回退路径"],
      "gate": ["关键状态可恢复", "断点有布局策略", "无未解释的全局状态"],
      "evidence": ["架构说明", "设计 brief"],
      "rules": ["ENG-14", "ENG-16", "ENG-18"]
    },
    {
      "id": "SOP-04",
      "title": "任务拆解",
      "phase": "planning",
      "purpose": "把任务包拆成可独立验证的步骤，每步有输入/输出/门禁。",
      "inputs": ["任务包", "架构", "依赖"],
      "steps": ["按页面/能力拆步", "为每步写 evidence", "标出前置依赖", "留出返工预算"],
      "gate": ["每步有验证方式", "依赖无环", "单步可回退"],
      "evidence": ["计划", "harness checkpoints"],
      "rules": ["ENG-01", "ENG-02"]
    },
    {
      "id": "SOP-05",
      "title": "编码实现",
      "phase": "implementation",
      "purpose": "按约束写最小实现，避免顺手重构和引入未验证依赖。",
      "inputs": ["任务包", "设计 brief", "现有代码"],
      "steps": ["先读约束与反模式", "实现最小变更", "保持 token/组件边界", "本地静态检查"],
      "gate": ["无新增 any/伪包/旧 @ohos.*", "状态边界正确", "变更可回滚"],
      "evidence": ["diff", "scan 结果"],
      "rules": ["ENG-16", "ENG-28"]
    },
    {
      "id": "SOP-06",
      "title": "构建与签名",
      "phase": "build",
      "purpose": "把代码变成可安装产物，失败时先分类环境/代码/签名。",
      "inputs": ["工程", "模块", "签名配置"],
      "steps": ["build", "signature generate", "检查产物与 debuggable", "保存日志"],
      "gate": ["build 退出码 0", "sign 退出码 0", "产物存在"],
      "evidence": ["build.log", "sign.log", "产物路径"],
      "rules": ["ENG-04", "ENG-05", "ENG-25"]
    },
    {
      "id": "SOP-07",
      "title": "安装与启动",
      "phase": "install",
      "purpose": "证明应用能装到目标设备并启动，不把安装失败混进功能结论。",
      "inputs": ["构建产物", "设备 sn"],
      "steps": ["run/install", "启动", "抓启动日志", "确认前台页面"],
      "gate": ["安装退出码 0", "启动无崩溃", "目标页面可见"],
      "evidence": ["run 日志", "设备 sn", "启动截图"],
      "rules": ["ENG-06"]
    },
    {
      "id": "SOP-08",
      "title": "功能验证",
      "phase": "functional",
      "purpose": "按用户路径验证行为，而不是只看界面是否存在。",
      "inputs": ["任务包判据", "设备", "测试数据"],
      "steps": ["走主路径", "走空/错/边界", "断网/重试", "记录每步证据"],
      "gate": ["must 判据全部有证据", "异常路径不崩溃"],
      "evidence": ["截图/日志/布局树"],
      "rules": ["ENG-06", "ENG-21"]
    },
    {
      "id": "SOP-09",
      "title": "审美与 UI 取证",
      "phase": "aesthetic",
      "purpose": "用测量而不是“我觉得好看”判断设计是否落地。",
      "inputs": ["设计 brief", "截图", "布局树", "tokens"],
      "steps": ["对照 token/间距/圆角", "量对比度", "检查层级与焦点", "记录偏差"],
      "gate": ["关键值有实测", "装饰不侵入正文", "深色/浅色都可读"],
      "evidence": ["截图", "布局树 bounds", "对比度数值"],
      "rules": ["ENG-07", "ENG-08", "ENG-13", "ENG-29"]
    },
    {
      "id": "SOP-10",
      "title": "无障碍验证",
      "phase": "accessibility",
      "purpose": "证明读屏、触控、焦点、字体放大可用，不只补属性。",
      "inputs": ["关键页面", "设备", "无障碍树"],
      "steps": ["检查可读文本/accessibilityId", "量触控 ≥48vp", "走焦点顺序", "2× 字体截图"],
      "gate": ["无无标签交互节点", "触控达标", "大字体不截断"],
      "evidence": ["布局树", "读屏记录", "大字体截图"],
      "rules": ["ENG-09", "ENG-15", "ENG-29"]
    },
    {
      "id": "SOP-11",
      "title": "性能验证",
      "phase": "performance",
      "purpose": "用同机前后对比证明启动/滚动/内存达标。",
      "inputs": ["性能判据", "设备", "基线"],
      "steps": ["冷启动分段", "滚动超长帧", "内存曲线", "低端机复测"],
      "gate": ["首帧/超长帧/内存有数值", "优化前后同机", "无持续增长"],
      "evidence": ["Profiler", "帧图", "内存曲线"],
      "rules": ["ENG-10", "ENG-11", "ENG-12"]
    },
    {
      "id": "SOP-12",
      "title": "回归验证",
      "phase": "regression",
      "purpose": "确认修复没有破坏已有路径，并覆盖上次失败点。",
      "inputs": ["返工单", "变更 diff", "旧用例"],
      "steps": ["复跑失败用例", "跑相邻路径", "检查导航/状态", "记录未覆盖项"],
      "gate": ["失败用例转通过", "相邻路径不回归", "未覆盖项显式列出"],
      "evidence": ["回归截图/日志"],
      "rules": ["ENG-18", "ENG-20"]
    },
    {
      "id": "SOP-13",
      "title": "发布与 AGC 提审",
      "phase": "release",
      "purpose": "发布前把签名、隐私、权限、包信息、回滚一次核对。",
      "inputs": ["发布包", "AGC 清单", "隐私政策"],
      "steps": ["发布签名/不可调试", "权限与隐私政策对照", "包名/版本/图标", "回滚预案"],
      "gate": ["debuggable=false", "权限/隐私一致", "回滚可执行"],
      "evidence": ["签名检查", "AGC 清单", "回滚演练"],
      "rules": ["ENG-23", "ENG-24", "ENG-25", "ENG-32"]
    },
    {
      "id": "SOP-14",
      "title": "缺陷与热修",
      "phase": "bugfix",
      "purpose": "从现场证据出发做最小修复，避免顺手重构扩大风险。",
      "inputs": ["崩溃/日志", "复现步骤", "版本信息"],
      "steps": ["稳定复现", "定位最小根因", "最小修改", "同路径回归"],
      "gate": ["复现路径可重复", "修复后同路径通过", "无相邻回归"],
      "evidence": ["日志", "复现步骤", "修复前后截图"],
      "rules": ["ENG-27", "ENG-20"]
    }
  ]
}
